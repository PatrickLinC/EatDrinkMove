<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>卡路里大作戰</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>拍攝餐點照片讓 AI 估算熱量，或掃描商品條碼。</string>
	<key>NSHealthShareUsageDescription</key>
	<string>讀取 Apple Watch 記錄的步數、距離、睡眠、心率變異度、運動路線與體重，用在今日摘要、精靈收集、精神力與開拓地圖。</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>把你記錄的飲食、喝水、體重、散步跑步路線和呼吸練習存進「健康」App。</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>打開「世界迷霧」自動解除後，用省電的大範圍定位在背景解除你去過的地方。位置只存在這支 iPhone。</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>按下「出發冒險」後記錄散步、跑步的路線，並解除世界迷霧。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>用說的補充餐點內容（例如「飯只吃半碗」），讓 AI 判讀得更準。</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>把「路線圖」存到你的相簿。</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>「用照片解除迷霧」時讀取照片的拍攝地點，把去過的地方的迷霧解開。照片不會離開這支 iPhone。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>把你說的餐點說明轉成文字，交給 AI 參考。</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIAppFonts</key>
	<array>
		<string>Cubic_11.ttf</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
