// 內建在程式裡的 API 金鑰。
// 把金鑰貼在引號中間就不用再到 App 設定輸入；App 設定裡輸入的金鑰會優先使用。
// 使用方式：把這個檔案複製成 Secrets.swift（已列在 .gitignore，不會被上傳），再填入金鑰。
// 請不要把填了金鑰的 Secrets.swift 分享給別人或上傳。

enum Secrets {
    /// Google AI Studio 建立的金鑰（AQ. 或 AIza 開頭）
    static let geminiAPIKey = ""
    /// Anthropic Console 建立的金鑰（sk-ant- 開頭，選用）
    static let claudeAPIKey = ""
}
